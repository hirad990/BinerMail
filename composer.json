{
  "name": "binercraft/biner-mail",
  "description": "BinerMail - professional self-hosted webmail and OAuth provider",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "phpmailer/phpmailer": "^6.9",
    "webklex/php-imap": "^6.1",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {"psr-4": {"BinerMail\\": "app/"}},
  "scripts": {"post-install-cmd": ["@php -r \"is_dir('storage') || mkdir('storage',0775,true);\""]}
}
